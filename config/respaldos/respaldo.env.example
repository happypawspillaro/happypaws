# Copiar a ~/.config/happypaws/respaldo.env (ver INSTALL.md).
# Las claves públicas de age se leen de ~/.config/happypaws/respaldo.age.pub;
# para usar otro archivo, define AGE_DESTINATARIOS.

# Días que se guardan los respaldos locales.
DIAS_RETENCION=30
# Días que se guardan los respaldos en la nube.
DIAS_RETENCION_NUBE=365
# Remoto y carpeta de rclone donde se sube la copia mensual.
RCLONE_DESTINO=gdrive:happypaws-respaldos
# Carpeta del repositorio en el VPS.
REPO_DIR=/home/happypaws/happypaws
