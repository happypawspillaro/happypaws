# Copiar a /etc/happypaws/respaldo.env (ver INSTALL.md).

# Carpeta del repositorio en el VPS.
REPO_DIR=/home/happypaws/happypaws
# Claves públicas de age (una por línea). La clave privada NO va en el VPS.
AGE_DESTINATARIOS=/etc/happypaws/respaldo.age.pub
# Días que se guardan los respaldos locales.
DIAS_RETENCION=30
# Remoto y carpeta de rclone donde se sube la copia mensual.
RCLONE_DESTINO=gdrive:happypaws-respaldos
