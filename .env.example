# Copia este archivo a .env y ajusta los valores.

# --- Desarrollo ---
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite (desarrollo, por defecto). Para PostgreSQL usa, por ejemplo:
# DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/happypaws
DATABASE_URL=sqlite:///db.sqlite3

# --- Correo ---
# Por defecto los correos se imprimen en la consola (consolemail://).
# Para enviar de verdad, define EMAIL_URL (ejemplo con Gmail + clave de aplicación):
# EMAIL_URL=smtp://usuario@gmail.com:clave-de-aplicacion@smtp.gmail.com:587/?tls=True
# DEFAULT_FROM_EMAIL=Happy Paws Píllaro <no-reply@tudominio.com>
# Correo de la fundación que recibe avisos de actividad en los reportes:
# FOUNDATION_EMAIL=fundacion@tudominio.com

# --- Producción (ejemplo para PythonAnywhere) ---
# Genera una SECRET_KEY nueva, no reutilices la de desarrollo:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=clave-larga-y-aleatoria
# DEBUG=False
# ALLOWED_HOSTS=tuusuario.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com
# DATABASE_URL=sqlite:///db.sqlite3
